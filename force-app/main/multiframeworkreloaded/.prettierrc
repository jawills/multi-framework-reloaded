{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "plugins": ["@prettier/plugin-xml"],
  "overrides": [
    {
      "files": ["*.xml", "*.*-meta.xml"],
      "options": { "parser": "xml" }
    }
  ]
}
